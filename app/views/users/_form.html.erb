<div class="card" style="max-width: 28rem;">
  <%= form_with model: @user, local: true do |f| %>
    <div class="field">
      <%= f.label :name, class: "label" %>
      <%= f.text_field :name, class: "input", required: true %>
    </div>
    <div class="field">
      <%= f.label :email, class: "label" %>
      <%= f.email_field :email, class: "input", required: true %>
    </div>
    <div class="field">
      <%= f.label :password, class: "label" %>
      <%= f.password_field :password, class: "input", autocomplete: "new-password" %>
    </div>
    <div class="field">
      <%= f.label :password_confirmation, "Confirm password", class: "label" %>
      <%= f.password_field :password_confirmation, class: "input", autocomplete: "new-password" %>
    </div>
    <div class="field">
      <%= f.label :role, class: "label" %>
      <%= f.select :role, User::ROLES, {}, class: "input" %>
    </div>
    <div class="field">
      <label class="label"><%= f.check_box :admin %> Admin</label>
    </div>
    <div class="row-gap mt-4">
      <%= f.submit "Save", class: "btn btn-primary" %>
      <%= link_to "Cancel", users_path, class: "btn btn-ghost" %>
    </div>
  <% end %>
</div>
