<!DOCTYPE html>
<html lang="en" class="h-full" data-bb-design="product-shell-v2">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : (ENV["APP_NAME"].presence || "App") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#07090d">
    <meta name="bowerbird-design" content="product-shell-v2">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag if respond_to?(:csp_meta_tag) %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        corePlugins: { preflight: false },
        theme: {
          extend: {
            colors: {
              brand: {
                300: "var(--color-brand-300)",
                400: "var(--color-brand-400)",
                500: "var(--color-brand-500)",
                600: "var(--color-brand-600)"
              }
            },
            fontFamily: {
              sans: ["DM Sans", "ui-sans-serif", "system-ui", "sans-serif"],
              mono: ["JetBrains Mono", "ui-monospace", "monospace"]
            }
          }
        }
      }
    </script>
    <link rel="stylesheet" href="/design/app.css" data-bb-theme="product-shell-v2">
    <% if respond_to?(:stylesheet_link_tag) %>
      <% begin %><%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %><% rescue StandardError %><% end %>
      <% begin %><%= stylesheet_link_tag "application", "data-turbo-track": "reload" %><% rescue StandardError %><% end %>
    <% end %>
    <%= javascript_importmap_tags if respond_to?(:javascript_importmap_tags) %>
    <%= yield :head if content_for?(:head) %>
  </head>
  <body class="h-full font-sans" data-controller="sidebar">
    <div class="app-shell">
      <%= render "shared/sidebar" %>
      <div class="app-main">
        <header class="app-topbar">
          <div class="flex items-center gap-3 min-w-0">
            <button type="button" class="btn btn-ghost btn-sm md:hidden" data-action="sidebar#toggle" aria-label="Open menu">☰</button>
            <div class="hidden sm:flex items-center gap-2 text-xs text-[var(--color-ink-400)]">
              <span class="font-mono text-[var(--color-brand-400)]"><%= (ENV["APP_NAME"].presence || "App").to_s[0] %></span>
              <span class="opacity-40">/</span>
              <span class="truncate"><%= content_for?(:title) ? strip_tags(yield(:title).to_s).split("—").first.to_s.strip : "Home" %></span>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <%= yield :topbar_actions if content_for?(:topbar_actions) %>
            <% if user_signed_in? %>
              <span class="text-xs text-[var(--color-ink-400)] hidden sm:inline"><%= current_user.display_name %></span>
              <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn btn-ghost btn-sm" %>
            <% end %>
          </div>
        </header>
        <%= render "shared/flash" %>
        <main class="app-content">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
