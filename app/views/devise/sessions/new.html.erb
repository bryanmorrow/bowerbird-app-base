<% content_for :title, "Sign in" %>
<div class="card">
  <div class="card-header">
    <h1 class="section-title">Sign in</h1>
  </div>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="field">
      <%= f.label :email, class: "label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "username", class: "input", required: true %>
    </div>
    <div class="field">
      <%= f.label :password, class: "label" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "input", required: true %>
    </div>
    <% if devise_mapping.rememberable? %>
      <div class="field">
        <label class="label"><%= f.check_box :remember_me %> Remember me</label>
      </div>
    <% end %>
    <div class="mt-4">
      <%= f.submit "Sign in", class: "btn btn-primary w-full" %>
    </div>
  <% end %>
</div>
