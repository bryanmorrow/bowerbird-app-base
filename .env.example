RAILS_ENV=production
RAILS_MASTER_KEY=
SECRET_KEY_BASE=
# Production: durable Postgres (Railway). Required — never use SQLite in production.
# On Railway web service: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:pass@host:5432/dbname
PORT=3000
APP_NAME=App
AUTH_REQUIRED=true
BOWERBIRD_OWNER_EMAIL=
BOWERBIRD_OWNER_NAME=
BOWERBIRD_OWNER_PASSWORD=
BOWERBIRD_PREVIEW_SECRET=
